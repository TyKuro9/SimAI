+void RoceSink::buffer_received_range(
+    RocePacket::seq_t first, RocePacket::seq_t last) {
+    if (last <= _cumulative_ack) {
+        return;
+    }
+    first = max<RocePacket::seq_t>(first, _cumulative_ack + 1);
+
+    map<RocePacket::seq_t, RocePacket::seq_t>::iterator next =
+        _received_intervals.lower_bound(first);
+    if (next != _received_intervals.begin()) {
+        map<RocePacket::seq_t, RocePacket::seq_t>::iterator previous = next;
+        --previous;
+        if (previous->second >= first - 1) {
+            first = previous->first;
+            last = max(last, previous->second);
+            next = _received_intervals.erase(previous);
+        }
+    }
+    while (next != _received_intervals.end() && next->first <= last + 1) {
+        last = max(last, next->second);
+        next = _received_intervals.erase(next);
+    }
+    _received_intervals[first] = last;
+}
+
+void RoceSink::advance_cumulative_ack() {
+    while (!_received_intervals.empty()) {
+        map<RocePacket::seq_t, RocePacket::seq_t>::iterator next =
+            _received_intervals.begin();
+        if (next->first > _cumulative_ack + 1) {
+            break;
+        }
+        _cumulative_ack = max(_cumulative_ack, next->second);
+        _received_intervals.erase(next);
+    }
 }
 
 
