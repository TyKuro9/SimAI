+void RoceSrc::set_paths(vector<const Route*>* rt_list) {
+    assert(_sink);
+    assert(rt_list);
+    assert(rt_list->size() > 0);
+
+    for (Route* route : _paths) {
+        delete route;
+    }
+    _paths.clear();
+    _paths.reserve(rt_list->size());
+
+    for (size_t i = 0; i < rt_list->size(); i++) {
+        Route* tmp = new Route(*(rt_list->at(i)), *_sink);
+        tmp->add_endpoints(this, _sink);
+        tmp->set_path_id(i, rt_list->size());
+        _paths.push_back(tmp);
+    }
+    _crt_path = 0;
+    _active_path %= _paths.size();
+}
+
+const Route* RoceSrc::choose_route() {
+    if (_paths.empty()) {
+        return _route;
+    }
+
+    uint32_t choice = 0;
+    switch (_route_strategy) {
+    case ROCE_ROUTE_OBLIVIOUS:
+        choice = random_path_index();
+        break;
+    case ROCE_ROUTE_PLB:
+        if (_plb_congested_rounds > 0) {
+            _active_path = random_path_index();
+            _plb_congested_rounds = 0;
+            _plb_delivered = 0;
+            _plb_congested = 0;
+        }
+        choice = _active_path % _paths.size();
+        break;
+    case ROCE_ROUTE_REPS:
+        if (_packets_sent < _paths.size()) {
+            choice = _crt_path % _paths.size();
+            _crt_path = (_crt_path + 1) % _paths.size();
+        } else if (!_reps_good_paths.empty()) {
+            choice = _reps_good_paths.front() % _paths.size();
+            _reps_good_paths.pop_front();
+            _reps_good_paths.push_back(choice);
+        } else {
+            choice = random_path_index();
+        }
+        break;
+    case ROCE_ROUTE_INCREMENTAL:
+    default:
+        choice = _crt_path % _paths.size();
+        _crt_path = (_crt_path + 1) % _paths.size();
+        break;
+    }
+    _last_path = choice;
+    return _paths.at(choice);
+}
+
+uint32_t RoceSrc::random_path_index() {
+    if (_paths.empty()) {
+        return 0;
+    }
+    if (_route_rng_state == 0) {
+        _route_rng_state = 0x9e3779b9U ^ (_node_num * 2654435761U);
+    }
+    _route_rng_state ^= _route_rng_state << 13;
+    _route_rng_state ^= _route_rng_state >> 17;
+    _route_rng_state ^= _route_rng_state << 5;
+    return _route_rng_state % _paths.size();
+}
+
+void RoceSrc::add_reps_good_path(uint32_t path_id) {
+    if (_paths.empty()) {
+        return;
+    }
+    path_id %= _paths.size();
+    const size_t max_entries = min<size_t>(_paths.size() * 4, 64);
+    _reps_good_paths.push_back(path_id);
+    while (_reps_good_paths.size() > max_entries) {
+        _reps_good_paths.pop_front();
+    }
+}
+
+void RoceSrc::record_path_feedback(bool good) {
+    if (_paths.empty()) {
+        return;
+    }
+    if (_route_strategy == ROCE_ROUTE_REPS && good) {
+        add_reps_good_path(_last_path);
+    }
+    if (_route_strategy == ROCE_ROUTE_PLB) {
+        _plb_delivered++;
+        if (!good) {
+            _plb_congested++;
+        }
+        if (_base_rtt > 0 && _base_rtt != timeInf &&
+            eventlist().now() >= _plb_next_round) {
+            if (_plb_congested * 4 > _plb_delivered) {
+                _plb_congested_rounds++;
+            } else {
+                _plb_congested_rounds = 0;
+            }
+            _plb_delivered = 0;
+            _plb_congested = 0;
+            _plb_next_round = eventlist().now() + _base_rtt;
+        }
+    }
+}
