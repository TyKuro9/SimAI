+bool RoceSrc::recover_oldest_unacked() {
+    if (!_flow_started || _done || _sink == NULL || _flow_size == 0 ||
+        _last_acked >= _flow_size) {
+        return false;
+    }
+
+    _last_acked = max<uint64_t>(_last_acked, _sink->cumulative_ack());
+    if (_last_acked >= _flow_size) {
+        return false;
+    }
+
+    const uint64_t remaining = _flow_size - _last_acked;
+    const uint16_t packet_size = static_cast<uint16_t>(min<uint64_t>(_mss, remaining));
+    const uint64_t seqno = _last_acked + 1;
+    const bool last_packet = packet_size == remaining;
+    const Route* route = choose_route();
+    RocePacket* packet = RocePacket::newpkt(
+        _flow, *route, seqno, packet_size, true, last_packet, _dstaddr);
+    assert(packet);
+    packet->set_pathid(route->path_id() >= 0 ? route->path_id() : _last_path);
+    packet->flow().logTraffic(
+        *packet, *this, TrafficLogger::PKT_CREATESEND);
+    packet->set_ts(eventlist().now());
+    _packets_sent++;
+    _rtx_packets_sent += packet_size;
+    packet->sendOn();
+    return true;
+}
+
+bool RoceSrc::enter_final_recovery() {
+    if (_done || _final_recovery_mode) {
+        return false;
+    }
+    _final_recovery_mode = true;
+    _state_send = READY;
+    if (_sink != NULL) {
+        _last_acked = max<uint64_t>(_last_acked, _sink->cumulative_ack());
+    }
+    return true;
+}
